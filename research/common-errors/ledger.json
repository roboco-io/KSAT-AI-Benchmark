 "claims": [
  {
   "id": "C01",
   "text": "## \uc5f0\uad6c \uacb0\uacfc\n\n\uace0\ub4dd\uc810 \ubaa8\ub378\ub4e4\uc774 \uac19\uc740 \ubb38\ud56d\uc5d0\uc11c \uac19\uc740 \uc624\ub2f5\uc744 \uc120\ud0dd\ud558\ub294 \uc0ac\ub840\ub97c \ud655\uc778\ud588\ub2e4. \uadf8\ub7ec\ub098 \ub450 \ud574\uc5d0\uc11c \uc804\uccb4 \ubaa8\ub378\uc758 \ucd5c\ube48\uac12 \ud22c\ud45c\ub294 \uac01\uac01 146/147\ubb38\ud56d\uc73c\ub85c, \ud574\ub2f9 \uc5f0\ub3c4\uc758 \ucd5c\uace0 \ub2e8\uc77c \ubaa8\ub378\uc744 \ub118\uc9c0 \ubabb\ud588\ub2e4. \ubaa8\ub4e0 \ubb38\ud56d\uc5d0 \uc815\ub2f5\uc744 \uc81c\ucd9c\ud55c \ubaa8\ub378\uc774 \uc801\uc5b4\ub3c4 \ud558\ub098\uc529 \uc788\uc5c8\uc73c\ubbc0\ub85c, \uc815\ub2f5 \ud6c4\ubcf4\uc758 \uc874\uc7ac\uc640 \uc815\ub2f5\uc744 \uc120\ud0dd\ud558\ub294 \uc9d1\uacc4 \ub2a5\ub825\uc740 \uad6c\ubd84\ud574\uc57c \ud55c\ub2e4. \uc774 \uacb0\uacfc\ub294 \uace0\uc815 \ub2f5\uc548\uc5d0 \ub300\ud55c \ud0d0\uc0c9 \ubd84\uc11d\uc774\uba70 \uc77c\ubc18\uc801\uc778 \uc559\uc0c1\ube14 \ubb34\uc6a9\ub860\uc744 \uc785\uc99d\ud558\uc9c0 \uc54a\ub294\ub2e4.",
   "sources": [
    "SR"
   ]
  },
  {
   "id": "C02",
   "text": "## \uc790\ub8cc\uc640 \ubd84\uc11d \ub300\uc0c1\n\n2025\u00b72026\ud559\ub144\ub3c4\ub294 \uac01\uac01 147\uac1c \uace0\uc720 \ubb38\ud56d\uc774\ub2e4. \uad6d\uc5b4 56\u00b7\uc218\ud559 46\u00b7\uc601\uc5b4 45\ubb38\ud56d\uc774\uba70 \uacf5\ud1b5 \ubb38\ud56d\uc740 \ud55c \ubc88\ub9cc \uc13c\ub2e4. \uc5ec\ub7ec \uc120\ud0dd\uacfc\ubaa9\uc744 \ud569\uce5c \uc5f0\uad6c\uc6a9 \ubb38\ud56d \uc9d1\ud569\uc774\ubbc0\ub85c \uc2e4\uc81c \uc218\ud5d8\uc0dd \ud55c \uba85\uc758 \uc2dc\ud5d8 \uc810\uc218\uc640 \ub2e4\ub974\ub2e4. 2025\ub144 \uc644\ub8cc \uc774\ubbf8\uc9c0 \ubaa8\ub378 9\uac1c, 2026\ub144 \uc644\ub8cc \uc774\ubbf8\uc9c0 \ubaa8\ub378 10\uac1c\ub97c \uc8fc \ubd84\uc11d\uc5d0 \ud3ec\ud568\ud588\ub2e4. 2026\ub144 GLM\u00b7Qwen\uc740 \uc2e4\ud589 \uc624\ub958\uac00 \ub0a8\uc740 \ubbf8\uc644\ub8cc \uacb0\uacfc\ub77c \uc81c\uc678\ud588\uace0, Solar\ub294 \ud14d\uc2a4\ud2b8 \uc785\ub825\uc774\ub77c \uc81c\uc678\ud588\ub2e4. \ub450 \uc5f0\ub3c4 \uacf5\ud1b5 \ubaa8\ub378\uc740 9\uac1c\ub2e4.",
   "sources": [
    "S25",
    "S26",
    "SD25",
    "SD26",
    "SR"
   ]
  },
  {
   "id": "C03",
   "text": "\uc785\ub825\uc740 \uc791\uc5c5 \ud2b8\ub9ac\uc758 \uacf5\uac1c JSON\uc5d0\uc11c \uace0\uc815\ud55c \uc2a4\ub0c5\uc0f7\uc774\ub2e4. \uc6d0\ubcf8 \ubc0f \uc2a4\ub0c5\uc0f7 SHA-256\uc744 manifest\uc5d0 \uae30\ub85d\ud588\ub2e4. \ubbf8\ucee4\ubc0b \ubcc0\uacbd\uc744 \ud3ec\ud568\ud560 \uc218 \uc788\uc73c\uba70, \uc774\ud6c4 \uacf5\uac1c JSON \uac31\uc2e0\uc740 \ubd84\uc11d\uc5d0 \uc790\ub3d9 \ubc18\uc601\ub418\uc9c0 \uc54a\ub294\ub2e4. \uc815\ub2f5\uc740 \ud504\ub85c\uc81d\ud2b8\uc5d0 \uc800\uc7a5\ub41c \uacf5\uc2dd \uc815\ub2f5 \uba54\ud0c0\ub370\uc774\ud130\ub97c \uc0ac\uc6a9\ud588\ub2e4. \uacf5\uc2dd \ubb38\uc81c\uc9c0\u00b7\uc815\ub2f5 PDF\ub97c \uc774\ubc88 \uc5f0\uad6c\uc5d0\uc11c \uc0c8\ub85c \uac80\uc218\ud558\uc9c0\ub294 \uc54a\uc558\ub2e4. \uc0c8 \ubaa8\ub378 \ud638\ucd9c, \uae30\uc874 \ub2f5\uc548\u00b7\ucc44\uc810\u00b7\uc6f9 \ud654\uba74\uc758 \uc218\uc815\uc740 \uc5c6\ub2e4.",
   "sources": [
    "SM",
    "SC"
   ]
  },
  {
   "id": "C04",
   "text": "## \ubc29\ubc95\n\n\uacf5\uc2dd \uc815\ub2f5 \uae30\uc900\uc73c\ub85c \uc800\uc7a5 answer\ub97c \ub2e4\uc2dc \ucc44\uc810\ud55c\ub2e4. 2026 \uc601\uc5b4 37\ubc88\uc740 \uacf5\uc2dd \u2464\ub9cc \uc815\ub2f5\uc774\ub2e4. \ub300\uc2dc\ubcf4\ub4dc\uc758 \u2463\u00b7\u2464 \uc778\uc815 \uc815\ucc45\uc740 \ubcc4\ub3c4 \ubcf4\uc815 \ubd84\uc11d\uc5d0\ub9cc \uc801\uc6a9\ud55c\ub2e4. \uae30\uc874 status=correct\ub97c \uadf8\ub300\ub85c \uc815\ub2f5\uc73c\ub85c \uc138\uc9c0 \uc54a\ub294\ub2e4. \uc720\ud6a8 \uc624\ub2f5\uc740 \ub2f5\uc744 \uc81c\ucd9c\ud588\uc73c\ub098 \uae30\uc900 \uc815\ub2f5\uacfc \ub2e4\ub978 \uacbd\uc6b0\ub2e4. \ubbf8\uc815\ub2f5(noncorrect)\uc740 \uc720\ud6a8 \uc624\ub2f5\u00b7\uae30\uad8c\u00b7\uc2e4\ud589 \uc624\ub958\u00b7\ubbf8\uc81c\ucd9c\uc744 \ud3ec\ud568\ud55c\ub2e4. \uc624\ub2f5 \uc120\ud0dd \uc720\uc0ac\ub3c4\uc5d0\uc11c\ub294 \uc720\ud6a8 \uc624\ub2f5\ub9cc \ube44\uad50\ud558\uace0 \ubd84\ubaa8\ub97c \ud568\uaed8 \uc81c\uc2dc\ud55c\ub2e4.",
   "sources": [
    "S26",
    "SD26",
    "SC"
   ]
  },
  {
   "id": "C05",
   "text": "\ubaa8\ub378 \uc30d\ubcc4\ub85c \ubbf8\uc815\ub2f5 \uc9d1\ud569 Jaccard(\uad50\uc9d1\ud569/\ud569\uc9d1\ud569), \uc720\ud6a8 \uc624\ub2f5 \uc9d1\ud569 Jaccard, \uacf5\ub3d9 \ubbf8\uc815\ub2f5 \uc218, \ub450 \ubaa8\ub378 \ubaa8\ub450 \uc720\ud6a8 \uc624\ub2f5\uc77c \ub54c \ub3d9\uc77c \ub2f5\uc744 \uace0\ub978 \uc218/\ube44\uc728\uc744 \uacc4\uc0b0\ud588\ub2e4. \ube48 \ubd84\ubaa8\ub294 null\uc774\ub2e4. \ub3c5\ub9bd \uac00\uc815\ud558\uc758 \uae30\ub300 \uacf5\ub3d9 \ubbf8\uc815\ub2f5 \uc218\ub3c4 \uc81c\uacf5\ud558\uc9c0\ub9cc, \ubb38\ud56d \ub09c\uc774\ub3c4\uc640 \ubaa8\ub378 \ub2a5\ub825\uc744 \ud1b5\uc81c\ud558\uc9c0 \uc54a\uc740 \ucc38\uace0\uac12\uc774\ub2e4. \uad00\uce21/\uae30\ub300 \ucc28\uc774\ub97c \ud559\uc2b5 \ub370\uc774\ud130 \uacf5\uc720\ub098 \ubaa8\ub378 \ud608\ud1b5\uc758 \uc99d\uac70\ub85c \ud574\uc11d\ud558\uc9c0 \uc54a\ub294\ub2e4. \ubaa8\ub378 \uc30d\ub4e4\uc740 \uc11c\ub85c \ub3c5\ub9bd\ub41c \ud45c\ubcf8\uc774 \uc544\ub2c8\ub2e4.",
   "sources": [
    "SC"
   ]
  },
  {
   "id": "C06",
   "text": "\ucd5c\ube48\uac12 \ud22c\ud45c(plurality)\ub294 \uc720\ud6a8 \ub2f5\uc758 \uc720\uc77c\ud55c \ucd5c\ube48\uac12\uc744 \uc120\ud0dd\ud558\uba70 \ub3d9\ub960\u00b7\uc804\uc6d0 \ubbf8\uc751\ub2f5\uc740 \uae30\uad8c\ud55c\ub2e4. \uc5c4\uaca9\ud55c \uacfc\ubc18\uc218(strict majority)\ub294 \uc804\uccb4 \ud328\ub110 \ubaa8\ub378 \uc218\uc758 \uc808\ubc18\uc744 \ucd08\uacfc\ud558\ub294 \uc9c0\uc9c0\ub97c \ucd94\uac00\ub85c \uc694\uad6c\ud55c\ub2e4. \uae30\uad8c\u00b7\uc624\ub958\ub294 \ud22c\ud45c\ud558\uc9c0 \uc54a\uc9c0\ub9cc \ud3c9\uac00 \ubd84\ubaa8\uc5d0\uc11c\ub294 \ube60\uc9c0\uc9c0 \uc54a\ub294\ub2e4. Oracle\uc740 \ubb38\ud56d\ub9c8\ub2e4 \uc815\ub2f5 \ubaa8\ub378\uc744 \uc0ac\ud6c4 \uc120\ud0dd\ud558\ub294 \uc2e4\ud604 \ubd88\uac00\ub2a5\ud55c \uc0c1\ud55c\uc774\ub2e4. \ub3d9\uc77c \uc5f0\ub3c4 \ucd5c\uace0 \ubaa8\ub378\uc740 \uad00\uce21 \uacb0\uacfc\ub85c \uace0\ub978 \uc0ac\ud6c4 \ube44\uad50 \uae30\uc900\uc774\ub2e4.",
   "sources": [
    "SC"
   ]
  },
  {
   "id": "C07",
   "text": "## \uc804\uccb4 \ud22c\ud45c \uacb0\uacfc\n\n| \ud559\ub144\ub3c4 | \uc644\ub8cc \uc774\ubbf8\uc9c0 \ubaa8\ub378 | \ucd5c\uace0 \ub2e8\uc77c | \ucd5c\ube48\uac12 \ud22c\ud45c | \uc5c4\uaca9\ud55c \uacfc\ubc18\uc218 | Oracle |\n|---|---:|---:|---:|---:|---:|\n| 2025 | 9 | 146/147 | 146/147 | 146/147 | 147/147 |\n| 2026 | 10 | 147/147 | 146/147 | 145/147 | 147/147 |\n\n2026\ub144 \ucd5c\ube48\uac12 \ud22c\ud45c\ub294 \ucd5c\uace0 \ub2e8\uc77c \ub300\ube44 \uac1c\uc120 0\ubb38\ud56d\u00b7\uc545\ud654 1\ubb38\ud56d\uc774\ub2e4. \uc5c4\uaca9\ud55c \uacfc\ubc18\uc218\ub294 1\ubb38\ud56d\uc744 \uacb0\uc815\ud558\uc9c0 \ubabb\ud55c\ub2e4. 2025\ub144 \ucd5c\ube48\uac12 \ud22c\ud45c\ub294 \ucd5c\uace0 \ub2e8\uc77c\uacfc \ubb38\ud56d\ubcc4 \uc815\uc624\ub3c4 \ub3d9\uc77c\ud558\ub2e4.\n\n![\uacf5\uc2dd \uc815\ub2f5 \uae30\uc900 \ud22c\ud45c \uc131\ub2a5](outputs/voting-performance.png)",
   "sources": [
    "SR"
   ]
  },
  {
   "id": "C08",
   "text": "## \ubaa8\ub378\ubcc4 \uacf5\uc2dd \ucc44\uc810\n\n| \ubaa8\ub378 | 2025 \uacf5\uc2dd \uc815\ub2f5 \uc218 | 2026 \uacf5\uc2dd \uc815\ub2f5 \uc218 |\n|---|---:|---:|\n| claude-fable-5-1 | 145 | 146 |\n| claude-haiku-5-5 | 132 | 129 |\n| claude-opus-5-5 | 145 | 146 |\n| claude-sonnet-5-5 | 145 | 141 |\n| deepseek-v4.1-flash | \ubd84\uc11d \ub300\uc0c1 \uc5c6\uc74c | 108 |\n| gemini-4-argon | 146 | 146 |\n| gpt-6-astra | 146 | 147 |\n| gpt-6-luna | 105 | 112 |\n| gpt-6.1-sol | 145 | 142 |\n| kimi-k3 | 139 | 138 |\n\n\ubd84\ubaa8\ub294 \ubaa8\ub450 147\uc774\ub2e4. \uae30\uad8c\ub3c4 \uc815\ub2f5 \uc218\ub97c \ub298\ub9ac\uc9c0 \uc54a\ub294\ub2e4. \ubaa8\ub378\uba85\uc740 \ud504\ub85c\uc81d\ud2b8 \uc800\uc7a5 \uc2dd\ubcc4\uc790\uc774\uba70, \uacf5\uae09\uc790\ubcc4 \ub3d9\uc77c\ud55c high \uc124\uc815\uc774 \ub3d9\uc77c \uacc4\uc0b0\ub7c9\uc744 \ub73b\ud558\uc9c0 \uc54a\ub294\ub2e4. SDK\u00b7\uc778\uc99d \uacbd\ub85c\u00b7\ucd9c\ub825 \uc0c1\ud55c\u00b7\uc2e4\ud589 \uc2dc\uc810\ub3c4 \ud1b5\uc77c\ub418\uc9c0 \uc54a\uc558\ub2e4.",
   "sources": [
    "SR",
    "S25",
    "S26"
   ]
  },
  {
   "id": "C09",
   "text": "## \uc0ac\ub840: 2025\ud559\ub144\ub3c4 \uad6d\uc5b4 \uacf5\ud1b5 7\ubc88\n\n\uacf5\uc2dd \uc815\ub2f5\uc740 2\uc774\ub2e4. \uc644\ub8cc \uc774\ubbf8\uc9c0 \ud328\ub110 9\uac1c \uc911 5\uac1c\uac00 \ud2c0\ub838\ub2e4. \uc624\ub2f5 \ubd84\ud3ec\ub294 3\ubc88 5\uac1c\ub2e4. \ucd5c\ube48\uac12 \ud22c\ud45c\ub294 3\ubc88\uc73c\ub85c \uc624\ub2f5\uc774\ub2e4.\n\n\uc624\ub2f5 \ubaa8\ub378: claude-fable-5-1(3), claude-opus-5-5(3), gemini-4-argon(3), gpt-6-luna(3), kimi-k3(3).\n\n\uc815\ub2f5 \ubaa8\ub378: claude-haiku-5-5, claude-sonnet-5-5, gpt-6-astra, gpt-6.1-sol.",
   "sources": [
    "SR",
    "SD25",
    "S25"
   ]
  },
  {
   "id": "C10",
   "text": "## \uc0ac\ub840: 2026\ud559\ub144\ub3c4 \uc601\uc5b4 37\ubc88\n\n\uacf5\uc2dd \uc815\ub2f5\uc740 5\uc774\ub2e4. \uc644\ub8cc \uc774\ubbf8\uc9c0 \ud328\ub110 10\uac1c \uc911 7\uac1c\uac00 \ud2c0\ub838\ub2e4. \uc624\ub2f5 \ubd84\ud3ec\ub294 4\ubc88 6\uac1c, 3\ubc88 1\uac1c\ub2e4. \ucd5c\ube48\uac12 \ud22c\ud45c\ub294 4\ubc88\uc73c\ub85c \uc624\ub2f5\uc774\ub2e4.\n\n\uc624\ub2f5 \ubaa8\ub378: claude-fable-5-1(4), claude-haiku-5-5(4), claude-opus-5-5(4), claude-sonnet-5-5(3), deepseek-v4.1-flash(4), gemini-4-argon(4), gpt-6.1-sol(4).\n\n\uc815\ub2f5 \ubaa8\ub378: gpt-6-astra, gpt-6-luna, kimi-k3.\n\nFable\u00b7Opus\u00b7Argon\uc740 \uacf5\uc2dd \uae30\uc900 146/147\ubb38\ud56d\uc774\uba70 \uc720\uc77c\ud55c \uc624\ub2f5\uc774 \ubaa8\ub450 \uc774 \ubb38\ud56d\uc758 \u2463\ub2e4. \uc774 \uc138 \ubaa8\ub378\uc758 \uc30d\ubcc4 Jaccard\ub294 1.00\uc774\uace0 \ub3d9\uc77c \uc624\ub2f5 \ube44\uc728\ub3c4 1/1\uc774\ub2e4. \uc774\ub294 \ub2e8 \ud55c \uc0ac\ub840\uc758 \uc644\uc804 \uc911\ucca9\uc774\ubbc0\ub85c \uc548\uc815\uc801\uc778 \ubaa8\uc9d1\ub2e8 \uc0c1\uad00 \ucd94\uc815\uc73c\ub85c \uc77d\uc73c\uba74 \uc548 \ub41c\ub2e4. \ubcf4\uc815 \ucc44\uc810\uc73c\ub85c \u2463\ub97c \uc778\uc815\ud558\uba74 \uc804\uccb4 \ud22c\ud45c\ub294 147/147\ub85c \ubc14\ub010\ub2e4. \ub530\ub77c\uc11c \uc8fc\uc694 \uc2e4\ud328 \uc0ac\ub840\uc758 \ud574\uc11d\uc740 \ucc44\uc810 \uc815\ucc45\uc5d0 \ubbfc\uac10\ud558\ub2e4. \uacf5\uc2dd \ubcf5\uc218\uc815\ub2f5 \uc778\uc815\uc774\ub77c\ub294 \ub73b\uc740 \uc544\ub2c8\ub2e4.",
   "sources": [
    "SR",
    "SD26",
    "S26"
   ]
  },
  {
   "id": "C11",
   "text": "## \uace0\ub4dd\uc810 \ubaa8\ub378\uacfc \uc30d\ubcc4 \uc911\ucca9\n\n\ub3d9\uc77c \uc5f0\ub3c4 \uacf5\uc2dd \uc815\ub2f5\ub960 95% \uc774\uc0c1\uc778 \ubaa8\ub378\uc740 \ub450 \ud574 \ubaa8\ub450 6\uac1c\ub2e4. \ud574\ub2f9 \ud328\ub110\uc758 \ucd5c\ube48\uac12 \ud22c\ud45c\ub294 \ub450 \ud574 \ubaa8\ub450 146/147\uc774\ub2e4. 2025\ub144 \uad6d\uc5b4 \uacf5\ud1b5 7\ubc88\uc5d0\uc11c\ub294 \uace0\ub4dd\uc810 \ubaa8\ub378 3/6\uac1c\uac00 \u2462\uc744 \uace8\ub790\uace0, \uc815\ub2f5 3\ud45c\u00b7\uc624\ub2f5 3\ud45c\uc758 \ub3d9\ub960\ub85c \ucd5c\ube48\uac12 \ud22c\ud45c\uac00 \uae30\uad8c\ud588\ub2e4. 2026\ub144 \uc601\uc5b4 37\ubc88\uc740 \uace0\ub4dd\uc810 \ubaa8\ub378 5/6\uac1c\uac00 \uacf5\uc2dd \uae30\uc900 \uc624\ub2f5\uc774\uc5c8\ub2e4. \uace0\ub4dd\uc810 \ud328\ub110\uc740 \uacb0\uacfc\ub97c \ubcf8 \ub4a4 \uae30\uc900\uc744 \uc801\uc6a9\ud55c \uae30\uc220 \ubd84\uc11d\uc774\uba70 \uc0ac\uc804 \uc120\ud0dd \uc804\ub7b5\uc758 \uc131\ub2a5\uc774 \uc544\ub2c8\ub2e4.\n\n![\uacf5\ud1b5 9\uac1c \ubaa8\ub378\uc758 \ubbf8\uc815\ub2f5 \uc9d1\ud569 \uc911\ucca9](outputs/error-overlap.png)\n\n\uadf8\ub9bc\uc740 \uae30\uad8c\uc744 \ud3ec\ud568\ud55c \ubbf8\uc815\ub2f5 Jaccard\ub2e4. \uac19\uc740 \uc120\ud0dd\uc9c0\uc758 \uc624\ub2f5\ub9cc\uc744 \uc758\ubbf8\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc804\uccb4 \uc30d\ubcc4 \uc218\uce58\uc640 \uc720\ud6a8 \uc624\ub2f5\ub9cc\uc758 \uc911\ucca9\uc740 pairs CSV\ub97c \ucc38\uc870\ud55c\ub2e4.\n\n\uace0\ub4dd\uc810 \ud328\ub110\uc758 15\uac1c \ubaa8\ub378 \uc30d \uc911 \uacf5\ub3d9 \ubbf8\uc815\ub2f5\uc774 \uc788\ub294 \uc30d\uc740 2025\ub144 4\uac1c\u00b72026\ub144 10\uac1c\uc774\uba70, \ub3d9\uc77c \uc624\ub2f5 \uc0ac\ub840\uac00 \uc788\ub294 \uc30d\uc740 \uac01\uac01 4\uac1c\u00b77\uac1c\ub2e4. \uc774\ub294 \uacf5\uc720 \ubb38\ud56d\uacfc \uacf5\uc720 \ubaa8\ub378\uc744 \ud3ec\ud568\ud55c \uae30\uc220 \ud1b5\uacc4\uc774\uba70 \uc5f0\ub3c4\ubcc4 \uc99d\uac00\uc758 \uc720\uc758\uc131\uc744 \ub73b\ud558\uc9c0 \uc54a\ub294\ub2e4.",
   "sources": [
    "SR"
   ]
  },
  {
   "id": "C12",
   "text": "## 2025\ub144\uc5d0\uc11c \uc120\ud0dd\ud55c \uc870\ud569\uc744 2026\ub144\uc5d0 \uc801\uc6a9\n\n\uacf5\ud1b5 9\uac1c \ubaa8\ub378\uc5d0\uc11c \uac00\ub2a5\ud55c 84\uac1c 3\ubaa8\ub378 \uc870\ud569\uc744 2025\ub144 \uc815\ub2f5 \uc218\ub85c \uc815\ub82c\ud558\uace0, \ub3d9\ub960\uc774\uba74 \ubaa8\ub378 ID \uc0ac\uc804\uc21c\uc73c\ub85c \uc120\ud0dd\ud588\ub2e4. \uc120\ud0dd\ub41c \uc870\ud569\uc740 claude-fable-5-1, claude-haiku-5-5, gpt-6-astra\uc774\ub2e4. \ub2e8\uc77c \ube44\uad50 \ubaa8\ub378\ub3c4 2025\ub144 \uacb0\uacfc\ub9cc\uc73c\ub85c \uace8\ub790\uc73c\uba70 gemini-4-argon\uc774\ub2e4.\n\n\uc120\ud0dd\ub41c \uc870\ud569\uc740 2025\ub144 147/147, 2026\ub144 146/147\uc774\ub2e4. 2025\ub144 \uc120\ud0dd \ub2e8\uc77c \ubaa8\ub378\uc740 \uac01\uac01 146/147, 146/147\uc774\ub2e4. \ub530\ub77c\uc11c 2026\ub144\uc5d0\ub294 \uc120\ud0dd \ub2e8\uc77c \ub300\ube44 \uac1c\uc120\ub3c4 \uc545\ud654\ub3c4 \uc5c6\ub2e4. 2026\ub144 \uc0ac\ud6c4 \ucd5c\uace0 \ub2e8\uc77c Astra(147/147)\ubcf4\ub2e4 \ud55c \ubb38\ud56d \ub0ae\ub2e4\ub294 \uc0ac\uc2e4\uacfc \uad6c\ubd84\ud574\uc57c \ud55c\ub2e4. \uc774 \ubd84\uc11d\uc740 \uc0ac\ud6c4 \uc124\uacc4\ud55c \uc5f0\ub3c4 \ubd84\ub9ac \ud3c9\uac00\ub2e4. \uc774\ubbf8 \ub450 \uc5f0\ub3c4\ub97c \ud655\uc778\ud588\uc73c\ubbc0\ub85c \uc0ac\uc804\ub4f1\ub85d\uc774\ub098 \uc644\uc804\ud788 \ub3c5\ub9bd\ub41c \uc804\ud5a5 \uac80\uc99d\uc73c\ub85c \uc8fc\uc7a5\ud558\uc9c0 \uc54a\ub294\ub2e4.",
   "sources": [
    "SR",
    "SC"
   ]
  },
  {
   "id": "C13",
   "text": "## \uc870\ud569 \ud0d0\uc0c9\uacfc \uc0c1\ud638\ubcf4\uc644\uc131\n\n| \ud559\ub144\ub3c4 | \ubaa8\ub4e0 3\ubaa8\ub378 \uc870\ud569 | \uad6c\uc131\uc6d0 \uc911 \ucd5c\uace0\ubcf4\ub2e4 \uac1c\uc120 | \ub3d9\uc77c | \uc545\ud654 |\n|---|---:|---:|---:|---:|\n| 2025 | 84 | 14 | 33 | 37 |\n| 2026 | 120 | 3 | 29 | 88 |\n\n\uae30\uc900\uc740 \uac01 \uc870\ud569 \uad6c\uc131\uc6d0 \uc911 \ucd5c\uace0 \ubaa8\ub378\uc774\ub2e4. \uc77c\ubd80 \uc870\ud569\uc758 \uac1c\uc120\uc740 \uc874\uc7ac\ud558\uc9c0\ub9cc \ub300\ubd80\ubd84\uc758 \uc870\ud569\uc774 \uac1c\uc120\ub418\ub294 \uac83\uc740 \uc544\ub2c8\ub2e4. \uc870\ud569\ub07c\ub9ac \ubaa8\ub378\u00b7\ubb38\ud56d\uc744 \uacf5\uc720\ud558\ubbc0\ub85c \uc774 \ube48\ub3c4\ub97c \ub3c5\ub9bd \uc2dc\ud589\uc758 \uc131\uacf5\ud655\ub960\ub85c \ud574\uc11d\ud560 \uc218 \uc5c6\ub2e4. 2025\ub144\uc758 \ucd5c\uc801 \uc870\ud569 \uc810\uc218\ub294 \uc120\ud0dd\uc5d0 \uc4f4 \uc790\ub8cc\uc5d0\uc11c \uc5bb\uc740 \ub099\uad00\uc801\uc778 \ud0d0\uc0c9 \uacb0\uacfc\ub2e4.",
   "sources": [
    "SR"
   ]
  },
  {
   "id": "C14",
   "text": "## \ubd88\ud655\uc2e4\uc131\n\n\uacfc\ubaa9\ubcc4 \uce35\ud654\ub97c \uc720\uc9c0\ud55c paired cluster bootstrap\uc744 4,000\ud68c \uc2dc\ud589\ud588\ub2e4(seed=20261122). \uc2e4\uc81c \uc9c0\ubb38 ID\uac00 \uc5c6\uc5b4 section\u00b7source_page\ub97c \uad70\uc9d1 \ub300\uc6a9\uc73c\ub85c \uc0ac\uc6a9\ud588\ub2e4. \uad6d\uc5b4 20\u00b7\uc218\ud559 20\u00b7\uc601\uc5b4 8\uac1c \uad70\uc9d1\uc774\ub2e4. 2026\ub144 \uc804\uccb4 \ucd5c\ube48\uac12 \ud22c\ud45c\uc758 \uc0ac\ud6c4 \ucd5c\uace0 \ub2e8\uc77c \ub300\ube44 \ucc28\uc774\ub294 \u22120.68%p, \ud398\uc774\uc9c0 \ub300\uc6a9 \uad70\uc9d1\uc758 95% \ubc31\ubd84\uc704 \uad6c\uac04\uc740 [-2.48, 0.00]%p\ub2e4. 0\uc744 \ud3ec\ud568\ud558\uba70 \ubcf4\uc815\ub41c \uac00\uc124\uac80\uc815\uc774\ub098 \uc77c\ubc18\ud654 \uc99d\uba85\uc774 \uc544\ub2c8\ub2e4.\n\n\uc2e4\ud589 \ubb36\uc74c \uad70\uc9d1\uc740 \uad6d\uc5b4 3\u00b7\uc218\ud559 4\u00b7\uc601\uc5b4 1\uac1c\ubfd0\uc774\ub2e4. \ubaa8\ub4e0 \ucc28\uc774\uac00 \uc601\uc5b4 37\ubc88\uc5d0 \uc788\uc5b4 \uc2e4\ud589 \ubb36\uc74c \uad6c\uac04\uc740 \u22120.68%p \ud55c \uc810\uc73c\ub85c \ud1f4\ud654\ud55c\ub2e4. \uc601\uc5b4 \ubb36\uc74c\uc774 \ud558\ub098\ub77c \ubcc0\ub3d9\uc131\uc744 \ucd94\uc815\ud560 \uc218 \uc5c6\ub2e4\ub294 \uc2e4\ud328 \uc2e0\ud638\uc774\uba70 \uc720\uc758\uc131\uc758 \uc99d\uac70\uac00 \uc544\ub2c8\ub2e4. \ud398\uc774\uc9c0 \ub300\uc6a9 \uad70\uc9d1\ub3c4 \uc5ec\ub7ec \ucabd\uc5d0 \uac78\uce5c \uc9c0\ubb38 \uc758\uc874\uc131\uc744 \ubcf4\uc874\ud558\uc9c0 \ubabb\ud55c\ub2e4. 2025\ub144 0 \ucc28\uc774 \uad6c\uac04\uacfc \uc120\ud0dd \ub2e8\uc77c \ub300\ube44 2026\ub144 0 \ucc28\uc774 \uad6c\uac04 \uc5ed\uc2dc \uad00\uce21 \ucc28\uc774\uac00 \uc5c6\ub2e4\ub294 \ub73b\uc77c \ubfd0 \ub3d9\ub4f1\uc131 \uac80\uc815\uc740 \uc544\ub2c8\ub2e4.\n\n\uc0ac\ud6c4 \ucd5c\uace0 \ub2e8\uc77c \ubaa8\ub378\uc740 \uc6d0\uc790\ub8cc\uc5d0\uc11c \ud55c \ubc88 \uc120\ud0dd\ud55c \ub4a4 bootstrap\uc5d0\uc11c \uace0\uc815\ud588\ub2e4. \uad6c\uac04\uc740 \uadf8 \uc120\ud0dd\uc5d0 \uc870\uac74\ubd80\uc774\uba70 \ucd5c\uace0 \ubaa8\ub378\uc744 \uc120\ud0dd\ud558\ub294 \uacfc\uc815\uc758 \ubd88\ud655\uc2e4\uc131\uc744 \ud3ec\ud568\ud558\uc9c0 \uc54a\ub294\ub2e4.",
   "sources": [
    "SR",
    "SC"
   ]
  },
  {
   "id": "C15",
   "text": "## \ubbfc\uac10\ub3c4 \ubd84\uc11d\n\n\ub450 \ud574 \uacf5\ud1b5 9\uac1c \ubaa8\ub378\ub9cc \ube44\uad50\ud574\ub3c4 \ucd5c\ube48\uac12 \ud22c\ud45c\ub294 \uac01\uac01 146/147\uc774\ub2e4. 2026\ub144 \ubbf8\uc644\ub8cc GLM\u00b7Qwen\uae4c\uc9c0 \ud3ec\ud568\ud55c \uc774\ubbf8\uc9c0 12\uac1c \ud328\ub110\ub3c4 146/147\uc774\ub2e4. \uc774 \ub458\uc740 \uc624\ub958 56\u00b716\uac1c\ub97c \ud3ec\ud568\ud558\uba70 \uc720\ud6a8 \ub2f5\ub9cc \ud22c\ud45c\ud55c\ub2e4. Solar \ud14d\uc2a4\ud2b8 \ubaa8\ub378\uc744 \uc644\ub8cc \ubaa8\ub378\uc5d0 \ucd94\uac00\ud55c 11\uac1c \ud328\ub110\ub3c4 146/147\uc774\ub2e4. \uc785\ub825 \uc870\uac74\uc744 \uc11e\uc740 \uacb0\uacfc\ub294 \uc8fc \ubd84\uc11d\uacfc \ubd84\ub9ac\ud55c\ub2e4.\n\n2026\ub144 \uc601\uc5b4 37\ubc88\uc5d0\uc11c \u2463\ub3c4 \uc778\uc815\ud558\uba74 \uc644\ub8cc \uc774\ubbf8\uc9c0 \ud328\ub110\uc758 \ud22c\ud45c\ub294 147/147\uc774 \ub41c\ub2e4. \ubcf4\uc815 \uacb0\uacfc\uc640 \uacf5\uc2dd \uacb0\uacfc\uc758 \ucc28\uc774\ub294 \ubaa8\ub378 \uc7ac\uc2e4\ud589 \uc5c6\uc774 \uc800\uc7a5 \ub2f5\uc548\ub9cc\uc73c\ub85c \uc0b0\ucd9c\ud588\ub2e4.",
   "sources": [
    "SR",
    "S26"
   ]
  },
  {
   "id": "C16",
   "text": "## \uc120\ud589\uc5f0\uad6c\uc640 \uc774\ubc88 \ubd84\uc11d\uc758 \uc704\uce58\n\nKim \ub4f1(2025)\uc758 Correlated Errors in Large Language Models\ub294 \uc11c\ub85c \ub2e4\ub978 \ubaa8\ub378\ub4e4\uc758 \uc624\ub958 \uc0c1\uad00\uc744 \ub300\uaddc\ubaa8\ub85c \uc870\uc0ac\ud588\ub2e4. \ubcf8 \uc5f0\uad6c\ub294 \uadf8 \ubb38\uc81c\uc758\uc2dd\uc744 \ud55c\uad6d \uc218\ub2a5 \uc6d0\ubcf8 \uc774\ubbf8\uc9c0\uc640 \ucc44\uc810 \uc815\ucc45 \ubbfc\uac10\ub3c4\uc5d0 \uc801\uc6a9\ud55c \uc18c\uaddc\ubaa8 \uc0ac\ub840 \ubd84\uc11d\uc774\ub2e4. Tekin \ub4f1(2024)\uc758 LLM-TOPLA\ub294 \ub2e4\uc591\uc131\uc744 \uace0\ub824\ud55c \ubaa8\ub378 \uc870\ud569 \uc120\ud0dd\uc744 \uc5f0\uad6c\ud588\ub2e4. \uc774\ubc88 \ubd84\uc11d\uc740 \ud559\uc2b5\ub41c \uacb0\ud569\uae30\ub97c \uad6c\ud604\ud558\uac70\ub098 \uadf8 \ub17c\ubb38\uc758 \uc131\ub2a5\uc744 \uc7ac\ud604\ud558\uc9c0 \uc54a\uc558\ub2e4. \ucd5c\ube48\uac12\u00b7\uacfc\ubc18\uc218\u00b7\uc0ac\ud6c4 oracle\uc744 \uad6c\ubd84\ud558\ub294 \uae30\ucd08\uc120\uc744 \uc81c\uacf5\ud55c\ub2e4. \uc644\uc804\ud55c \uc120\ud589\uc5f0\uad6c \uc870\uc0ac\ub098 \ucd5c\ucd08\uc131 \uac80\uc99d\uc740 \uc218\ud589\ud558\uc9c0 \uc54a\uc558\ub2e4.",
   "sources": [
    "SP1",
    "SP2"
   ]
  },
  {
   "id": "C17",
   "text": "## \ud55c\uacc4\uc640 \ub2e4\uc74c \ub2e8\uacc4\n\n\ud559\ub144\ub3c4 2\uac1c\u00b7\uc5f0\ub3c4\ub2f9 147\ubb38\ud56d\u00b7\ubaa8\ub378\ubcc4 \uc800\uc7a5 \uc2e4\ud589 \ud55c \ubc88\uc5d0 \uc758\uc874\ud55c\ub2e4. \ucd5c\uc0c1\uc704 \ubaa8\ub378\uc758 \uc624\ub958\uac00 \ub9e4\uc6b0 \uc801\uc5b4 \ud55c \ubb38\ud56d\uc774 \uacb0\uacfc\ub97c \uc88c\uc6b0\ud55c\ub2e4. \ubc18\ubcf5 \uc2e4\ud589 \uc548\uc815\uc131, \ubaa8\ub378 \ub2a5\ub825\uc744 \ud1b5\uc81c\ud55c \uc624\ub958 \uc758\uc874\uc131, \ud559\uc0dd\uacfc\uc758 \ub09c\uc774\ub3c4 \ube44\uad50\ub294 \uac80\uc99d\ud558\uc9c0 \uc54a\uc558\ub2e4. \ubaa8\ub378 \uc120\ud0dd\u00b7\uc81c\uacf5\uc790 \uad6c\uc131\u00b7\uc2e4\ud589 \ud504\ub85c\ud1a0\ucf5c \ucc28\uc774\uac00 \uc788\uc5b4 \uc624\ub958 \uc911\ucca9\uc758 \uc6d0\uc778\uc744 \ud559\uc2b5 \ub370\uc774\ud130\ub098 \uc544\ud0a4\ud14d\ucc98\ub85c \uc2dd\ubcc4\ud560 \uc218 \uc5c6\ub2e4. \uacf5\uac1c \uc804\ub144\ub3c4 \uc2dc\ud5d8\uc758 \ud559\uc2b5 \ub370\uc774\ud130 \ud3ec\ud568 \uac00\ub2a5\uc131\ub3c4 \ubc30\uc81c\ud558\uc9c0 \ubabb\ud55c\ub2e4. \uc601\uc5b4 \ub4e3\uae30\ub294 \uc74c\uc131\uc774 \uc544\ub2c8\ub77c \uacf5\uc2dd \ub300\ubcf8 \uc774\ubbf8\uc9c0 \ud3c9\uac00\ub2e4.\n\n\ub2e4\uc74c \uc5f0\uad6c\uc5d0\uc11c\ub294 \uc9c0\ubb38 ID\ub97c \uba3c\uc800 \uac80\uc218\ud558\uace0, \uc870\ud569\u00b7\ub3d9\ub960\u00b7\ucc44\uc810 \uaddc\uce59\uc744 \uc2e0\uaddc \ud559\ub144\ub3c4 \uacb0\uacfc \ud655\uc778 \uc804\uc5d0 \uace0\uc815\ud574\uc57c \ud55c\ub2e4. \uc774\ud6c4 \ub3d9\uc77c \ubaa8\ub378\u00b7\uc124\uc815\uc758 \uc0c8 \uc2dc\ud5d8\uc73c\ub85c \uac80\uc99d\ud558\uace0, \ud544\uc694\ud558\uba74 \ubcc4\ub3c4 \uc2b9\uc778\ub41c \ubc18\ubcf5 \uc2e4\ud589\uc73c\ub85c \ubcc0\ub3d9\uc131\uc744 \ucd94\uc815\ud55c\ub2e4. \ud604\uc7ac \uacb0\ub860\uc740 \u2018\uc0c1\ud638\ubcf4\uc644\uc801 \uc815\ub2f5\uc740 \uc874\uc7ac\ud558\uc9c0\ub9cc \ub2e8\uc21c \ud22c\ud45c\uac00 \uc774\ub97c \ud56d\uc0c1 \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud55c\ub2e4\u2019\ub294 \uad00\uce21 \uc218\uc900\uc73c\ub85c \uc81c\ud55c\ud55c\ub2e4.",
   "sources": [
    "SR",
    "S25",
    "S26",
    "SC"
   ]
  }
 ],
